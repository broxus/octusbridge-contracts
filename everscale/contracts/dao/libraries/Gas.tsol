pragma tvm-solidity >= 0.79.0;

import "../../utils/gas/GasParams.tsol";

library Gas {
    coins constant PROPOSAL_INITIAL_BALANCE = GasParams.STORAGE_FEE_K * 1 ever;
    coins constant ACCOUNT_INITIAL_BALANCE = GasParams.STORAGE_FEE_K * 0.2 ever;

    coins constant DEPLOY_PROPOSAL_GAS = 9_000_000;
    coins constant EXECUTE_TON_ACTION_GAS = 500_000;
    coins constant EXECUTE_ETH_ACTION_GAS = 500_000;
    coins constant UPGRADE_ACCOUNT_MIN_GAS = 2_000_000;
    coins constant UPGRADE_PROPOSAL_MIN_GAS = 2_000_000;
    coins constant UNLOCK_VOTE_GAS = 100_000;
    coins constant PROPOSAL_DEPLOYED_CALLBACK_GAS = 200_000;
    coins constant DEPLOY_EVENT_MIN_GAS = 1_000_000;

    function getDeployProposalValue() public returns(coins) {
        return gasToValue(DEPLOY_PROPOSAL_GAS) + PROPOSAL_INITIAL_BALANCE;
    }
}
