pragma tvm-solidity >= 0.79.0;

interface ActionStructure {
    struct TonAction {
        coins value;
        address target;
        TvmCell payload;
    }

    struct EthAction {
        uint value;
        uint32 chainId;
        uint160 target;
        string signature;
        bytes callData;
    }

    struct EthActionStripped {
        uint value;
        uint160 target;
        string signature;
        bytes callData;
    }
}
