pragma tvm-solidity >= 0.79.0;

library Gas {
    coins constant ROOT_INITIAL_BALANCE = 12 ever;
    coins constant USER_DATA_INITIAL_BALANCE = 12 ever;
    coins constant ELECTION_INITIAL_BALANCE = 12 ever;
    coins constant RELAY_ROUND_INITIAL_BALANCE = 12 ever;
    coins constant TOKEN_WALLET_INITIAL_BALANCE = 0.6 ever;

    // deploy
    coins constant TOKEN_WALLET_DEPLOY_GAS = 30_000;
    coins constant TOKEN_WALLET_EXTRA_GAS = 100_000;

    coins constant DEPLOY_ELECTION_MIN_GAS = 1_000_000;
    coins constant DEPLOY_RELAY_ROUND_MIN_GAS = 1_000_000;
    coins constant DEPLOY_USER_DATA_MIN_GAS = 1_000_000;
    coins constant USER_DATA_UPGRADE_GAS = 3_000_000;

    coins constant LINK_RELAY_ACCOUNTS_GAS = 200_000;

    function getDeployTokenWalletValue() public returns(coins) {
        return gasToValue(TOKEN_WALLET_DEPLOY_GAS) + TOKEN_WALLET_INITIAL_BALANCE;
    }

    function getDeployRelayRoundMinValue() public returns(coins) {
        return gasToValue(DEPLOY_RELAY_ROUND_MIN_GAS) + RELAY_ROUND_INITIAL_BALANCE;
    }

    function getDeployElectionMinValue() public returns(coins) {
        return gasToValue(DEPLOY_ELECTION_MIN_GAS) + ELECTION_INITIAL_BALANCE;
    }

    function getDeployUserDataMinValue() public returns(coins) {
        return gasToValue(DEPLOY_USER_DATA_MIN_GAS) + USER_DATA_INITIAL_BALANCE;
    }

    // min values for calls
    coins constant MIN_CALL_MSG_GAS = 8_000_000;
    coins constant MIN_CALL_MSG_FIXED_VALUE = 12 ever;
    coins constant MIN_END_ELECTION_MSG_GAS = 15_000_000;
    coins constant MIN_SEND_RELAYS_MSG_GAS = 2_000_000;
    coins constant DESTROY_MSG_GAS = 1_000_000;

    function getMinCallMsgValue() public returns(coins) {
        return gasToValue(MIN_CALL_MSG_GAS) + MIN_CALL_MSG_FIXED_VALUE;
    }

    function getMinEndElectionMsgValue() public returns(coins) {
        return gasToValue(MIN_END_ELECTION_MSG_GAS) +
               getDeployRelayRoundMinValue() +
               math.max(RELAY_ROUND_INITIAL_BALANCE, ELECTION_INITIAL_BALANCE); // stakingRelay.onRelayRoundDeployed
    }

    // DAO
    coins constant CAST_VOTE_GAS = 1_000_000;
    coins constant UNLOCK_LOCKED_VOTE_TOKENS_GAS = 500_000;
    coins constant UNLOCK_CASTED_VOTE_GAS = 200_000;
    coins constant UNLOCK_CASTED_VOTES_EXTRA_GAS = 1_000_000;
}
