pragma tvm-solidity >= 0.79.0;

library Gas {
    coins constant ROOT_INITIAL_BALANCE = 12 ever;
    coins constant RELAY_ROUND_INITIAL_BALANCE = 12 ever;

    // deploy
    coins constant DEPLOY_RELAY_ROUND_MIN_GAS = 1_000_000;

    function getDeployRelayRoundMinValue() public returns(coins) {
        return gasToValue(DEPLOY_RELAY_ROUND_MIN_GAS) + RELAY_ROUND_INITIAL_BALANCE;
    }

    // min values for calls
    coins constant MIN_CALL_MSG_GAS = 2_000_000;
    coins constant MIN_SEND_RELAYS_MSG_GAS = 2_000_000;
    coins constant DESTROY_MSG_GAS = 1_000_000;

    function getMinCallMsgValue() public returns(coins) {
        return gasToValue(MIN_CALL_MSG_GAS);
    }
}
