pragma tvm-solidity >= 0.79.0;

#[ExternalMessage(time, pubkey, expire)]
#[TimeReplayProt]
contract DummyRound {
    struct Relay {
        address staker_addr;
        uint256 ton_pubkey;
        uint160 eth_addr;
        uint128 staked_tokens;
    }
    uint256 static _randomNonce;
    Relay[] public relays;
    uint256[] public ton_keys;


    constructor() externalMsg {
        tvm.accept();
    }

    function addRelays(uint count) external externalMsg {
        tvm.accept();
        for (uint i = 0; i < count; i++) {
            address q = address.makeAddrStd(1, 1);
            Relay _rel = Relay(q, 1, 2, 3);
            relays.push(_rel);
            ton_keys.push(123123);
        }
    }

    function relayKeys() externalMsg internalMsg public view responsible returns (uint256[]) {
        uint256[] _keys = new uint256[](relays.length);
        for (uint256 i = 0; i < _keys.length; i++) {
            _keys[i] = relays[i].ton_pubkey;
        }
        return { value: 0, bounce: false, flag: 64 } _keys;
    }

    function relayKeysSimple() externalMsg internalMsg public view responsible returns (uint256[]) {
        return { value: 0, bounce: false, flag: 64 } ton_keys;
    }


}

