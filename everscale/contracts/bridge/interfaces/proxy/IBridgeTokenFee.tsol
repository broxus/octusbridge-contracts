pragma tvm-solidity >= 0.79.0;

interface IBridgeTokenFee{
    function getToken() externalMsg internalMsg external view responsible returns(address);
    function getProxy() externalMsg internalMsg external view responsible returns(address);
    function getAccumulatedFee() externalMsg internalMsg external responsible  returns(uint128);

    function accumulateFee(uint128 _fee) external;
    function checkAccumulatedFee(address _recipient) external responsible view returns(TvmCell);
    function upgrade(TvmCell _code, address _remainingGasTo) external;
}