pragma tvm-solidity >= 0.79.0;


interface IMergeRouter {
    function setPool(
        address pool_
    ) external;
    function setManager(
        address _manager
    ) external;

    function disablePool() external;

    function getPool() externalMsg internalMsg external responsible returns (address);
    function getDetails() externalMsg internalMsg external responsible returns (address, address, address);
}
