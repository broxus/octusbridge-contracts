pragma tvm-solidity >= 0.79.0;


interface IBasicEventConfiguration {
    enum EventAction {
        MultivaultAlien,
        MultivaultNative,
        TokenTransfer,
        Staking,
        Dao
    }

    enum EventType {
        EthereumEverscale,
        EverscaleEthereum,
        SolanaEverscale,
        EverscaleSolana,
        TvmTvm
    }

    struct BasicConfiguration {
        bytes eventABI;
        address staking;
        uint64 eventInitialBalance;
        TvmCell eventCode;
    }

    event NewEventContract(address eventContract);

    function getType() externalMsg internalMsg external pure responsible returns(EventType _type);
    function getFlags() externalMsg internalMsg external view responsible returns(uint64 _flags);
    function getEventAction() externalMsg internalMsg external view responsible returns(EventAction _eventAction);

    function setFlags(uint64 _flags) external;
    function setEventInitialBalance(uint64 eventInitialBalance) external;
    function setMeta(TvmCell _meta) external;
}
