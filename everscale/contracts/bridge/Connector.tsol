pragma tvm-solidity >= 0.79.0;

import "./../utils/ErrorCodes.tsol";
import "../utils/common/InternalOwner.tsol";
import "./interfaces/IConnector.tsol";

/**
    @title Connector contract is used for connecting event configurations to the
    basic Bridge contract.
*/
#[ExternalMessage(time)]
#[TimeReplayProt]
contract Connector is IConnector, InternalOwner {
    address static bridge;
    uint64 static id;

    address private eventConfiguration_;
    bool private enabled_;

    constructor(
        address _eventConfiguration,
        address _owner
    ) {
        require(bridge == msg.sender, ErrorCodes.DEPLOYER_NOT_BRIDGE);

        eventConfiguration_ = _eventConfiguration;
        enabled_ = false;

        setOwnership(_owner);
    }


    function eventConfiguration() externalMsg public view returns (address) {
        return eventConfiguration_;
    }

    function enabled() externalMsg public view returns (bool) {
        return enabled_;
    }

    /**
        @dev Enable event configuration
    */
    function enable() external override onlyOwner {
        enabled_ = true;

        emit Enabled();
    }

    /**
        @dev Get connector details
        @return _id Connector id
        @return _eventConfiguration Corresponding event configuration address
        @return _enabled Event configuration status
    */
    function getDetails() externalMsg external view returns(
        uint64 _id,
        address _eventConfiguration,
        bool _enabled
    ) {
        return (
            id,
            eventConfiguration_,
            enabled_
        );
    }
}
