pragma tvm-solidity >= 0.79.0;

import "../../../../interfaces/proxy/multivault/alien/IProxyMultiVaultAlien_V9.tsol";
import "./ProxyMultiVaultAlien_V10_MergeRouter.tsol";

import "@broxus/contracts/contracts/utils/CheckPubKey.tsol";
import "@broxus/contracts/contracts/utils/RandomNonce.tsol";


#[ExternalMessage(time, pubkey)]
#[TimeReplayProt]
contract ProxyMultiVaultAlien_V10 is
    ProxyMultiVaultAlien_V10_MergeRouter,
    CheckPubKey,
    RandomNonce
{
    constructor(address owner_) externalMsg checkPubKey {
        tvm.accept();

        _reserveTargetBalance();

        setOwnership(owner_);

        owner_.transfer({
            value: 0,
            bounce: false,
            flag: MsgFlag.ALL_NOT_RESERVED
        });
    }

    /// @notice Get current contract API version.
    /// Each time contract is upgraded, API version is incremented.
    /// @return Current API version
    function apiVersion() externalMsg internalMsg external override view responsible returns(uint8) {
        return{value: 0, bounce: false, flag: MsgFlag.REMAINING_GAS} api_version;
    }

    function upgrade(
        TvmCell code
    ) external onlyOwner {
        TvmCell data = abi.encode(
            evmConfiguration,
            solanaConfiguration,
            tvmConfiguration,
            _randomNonce,
            api_version,
            owner(),
            manager_,
            mergeRouter_,
            mergePool_,
            mergePoolPlatform_,
            mergePoolVersion_,
            proxyMultiVaultNative_,
            platformCode,
            tokenToDailyLimits,
            limitApprover
        );

        tvm.setcode(code);
        tvm.setCurrentCode(code);

        onCodeUpgrade(data);
    }

    function onCodeUpgrade(TvmCell data) private {
        tvm.resetStorage();

        (
            EVMConfiguration _evmConfiguration,
            SolanaConfiguration _solanaConfiguration,
            TVMConfiguration _tvmConfiguration,
            uint _randomNonce_,
            uint8  _api_version,
            address _owner,

            address _manager,
            TvmCell _mergeRouter,
            TvmCell _mergePool,
            TvmCell _mergePoolPlatform,
            uint8 _mergePoolVersion,
            address _proxyMultiVaultNative,
            TvmCell _platformCode
        ) = abi.decode(data, (
            EVMConfiguration,
            SolanaConfiguration,
            TVMConfiguration,
            uint,
            uint8,
            address,
            address,
            TvmCell,
            TvmCell,
            TvmCell,
            uint8,
            address,
            TvmCell
        ));

        evmConfiguration = _evmConfiguration;
        solanaConfiguration = _solanaConfiguration;
        tvmConfiguration = _tvmConfiguration;

        _randomNonce = _randomNonce_;
        api_version = _api_version + 1;
        setOwnership(_owner);

        manager_ = _manager;
        mergeRouter_ = _mergeRouter;
        mergePool_ = _mergePool;
        mergePoolPlatform_ = _mergePoolPlatform;
        mergePoolVersion_ = _mergePoolVersion;
        proxyMultiVaultNative_ = _proxyMultiVaultNative;
        platformCode = _platformCode;
    }
}
