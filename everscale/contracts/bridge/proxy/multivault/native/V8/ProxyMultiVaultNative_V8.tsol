pragma tvm-solidity >= 0.79.0;


import "./../../../../interfaces/proxy/multivault/native/IProxyMultiVaultNative_V8.tsol";
import "./ProxyMultiVaultNative_V8_Deposit.tsol";

import "@broxus/contracts/contracts/utils/CheckPubKey.tsol";
import "@broxus/contracts/contracts/utils/RandomNonce.tsol";


#[ExternalMessage(time)]
#[TimeReplayProt]
contract ProxyMultiVaultNative_V8 is ProxyMultiVaultNative_V8_Deposit, CheckPubKey, RandomNonce {
    constructor(address owner_) externalMsg checkPubKey {
        tvm.accept();

        setOwnership(owner_);
    }

    function upgrade(
        TvmCell code
    ) external onlyOwner {
        TvmCell data = abi.encode(
            evmConfiguration,
            solanaConfiguration,
            tvmConfiguration,
            owner(),
            api_version,
            dexMiddleware,
            proxyMultiVaultAlien_,
            _randomNonce,
            platformCode,
            tokenToDailyLimits,
            limitApprover,
            coldVault_,
            vaultWithdrawer_,
            wNativeAddresses_,
            eventAddressKeeperCode
        );

        tvm.setcode(code);
        tvm.setCurrentCode(code);

        onCodeUpgrade(data);
    }

    function onCodeUpgrade(TvmCell data) private {
        tvm.resetStorage();

        (
            EVMConfiguration _evmConfiguration,
            SolanaConfiguration _solanaConfiguration,
//            TVMConfiguration _tvmConfiguration,
            address _owner,
            uint8 _api_version,
            address _dexMiddleware,
            address _proxyMultiVaultAlien,
            uint _randomNonce_,
            TvmCell _platformCode
        ) = abi.decode(data, (
            EVMConfiguration,
            SolanaConfiguration,
//            TVMConfiguration,
            address,
            uint8,
            address,
            address,
            uint,
            TvmCell
        ));

        evmConfiguration = _evmConfiguration;
        solanaConfiguration = _solanaConfiguration;
//        tvmConfiguration = _tvmConfiguration;

        api_version = _api_version + 1;
        dexMiddleware = _dexMiddleware;
        proxyMultiVaultAlien_ = _proxyMultiVaultAlien;
        setOwnership(_owner);
        _randomNonce = _randomNonce_;
        platformCode = _platformCode;
    }
}
