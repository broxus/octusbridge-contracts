pragma tvm-solidity >= 0.79.0;

import "../../utils/gas/GasParams.tsol";

library EventCreditGas {
    coins constant EVENT_CLOSER_INITIAL_BALANCE = GasParams.STORAGE_FEE_K * 10 ever;
    coins constant EVENT_DEPLOYER_INITIAL_BALANCE = GasParams.STORAGE_FEE_K * 10 ever;
    coins constant TOKEN_WALLET_INITIAL_BALANCE = GasParams.STORAGE_FEE_K * 0.1 ever;

    coins constant EVENT_CLOSER_DEPLOY_GAS = 500_000;
    coins constant EVENT_DEPLOYER_DEPLOY_GAS = 500_000;

    coins constant DRAIN_EVENT_DEPLOYER_GAS = 100_000;
    coins constant CLOSE_EVENT_GAS = 100_000;

    function getDeployEventCloserValue() public returns(coins) {
        return gasToValue(EVENT_CLOSER_DEPLOY_GAS) + EVENT_CLOSER_INITIAL_BALANCE;
    }

    function getDeployEventDeployerValue() public returns(coins) {
        return gasToValue(EVENT_DEPLOYER_DEPLOY_GAS) + EVENT_DEPLOYER_INITIAL_BALANCE;
    }

    coins constant TOKEN_WALLET_DEPLOY_GAS = 30_000;

    function getDeployTokenWalletValue() public returns(coins) {
        return gasToValue(TOKEN_WALLET_DEPLOY_GAS) + TOKEN_WALLET_INITIAL_BALANCE;
    }
}