pragma tvm-solidity >= 0.79.0;


import "./../../interfaces/event-contracts/IEverscaleSolanaEvent.tsol";
import "./../../interfaces/event-configuration-contracts/IEverscaleSolanaEventConfiguration.tsol";

import "./../../event-contracts/multivault/solana/MultiVaultEverscaleSolanaEventAlien.tsol";
import "./../../event-contracts/multivault/solana/MultiVaultEverscaleSolanaEventNative.tsol";
import "./../../event-contracts/staking/StakingEverscaleSolanaEvent.tsol";
import "./../../event-contracts/token-transfer/TokenTransferEverscaleSolanaEvent.tsol";

import "../../../utils/common/InternalOwner.tsol";
import "./../../../utils/TransferUtils.tsol";
import "./../../../utils/ErrorCodes.tsol";

import "@broxus/contracts/contracts/utils/CheckPubKey.tsol";
import "@broxus/contracts/contracts/libraries/MsgFlag.tsol";


/// @title Basic Everscale-Solana event configuration contract
/// @author https://github.com/broxus
#[ExternalMessage(time, expire)]
#[TimeReplayProt]
contract EverscaleSolanaEventConfiguration is
    IEverscaleSolanaEventConfiguration,
    TransferUtils,
    InternalOwner,
    CheckPubKey
{
    BasicConfiguration static basicConfiguration;
    EverscaleSolanaEventConfiguration static networkConfiguration;
    EventAction static eventAction;

    TvmCell meta;
    uint64 flags;

    /// @param _owner Event configuration owner
    constructor(
        address _owner,
        TvmCell _meta
    ) externalMsg internalMsg checkPubKey reserveTargetBalance() {
        tvm.accept();

        setOwnership(_owner);

        meta = _meta;

        _owner.transfer({
            value: 0,
            bounce: false,
            flag: MsgFlag.ALL_NOT_RESERVED
        });
    }

    /// @dev Get configuration details
    /// @return _basicConfiguration Basic configuration settings
    /// @return _networkConfiguration Network specific configuration settings
    function getDetails() externalMsg internalMsg override public view responsible returns(
        BasicConfiguration _basicConfiguration,
        EverscaleSolanaEventConfiguration _networkConfiguration,
        TvmCell _meta
    ) {
        return {value: 0, flag: MsgFlag.REMAINING_GAS, bounce: false}(
            basicConfiguration,
            networkConfiguration,
            meta
        );
    }

    /// @dev Get event configuration type
    /// @return _type Configuration type (enum EventType)
    function getType() externalMsg internalMsg override public pure responsible returns(EventType _type) {
        return {value: 0, flag: MsgFlag.REMAINING_GAS, bounce: false} EventType.EverscaleSolana;
    }

    function getFlags() externalMsg internalMsg override public view responsible returns(uint64 _flags) {
        return {value: 0, flag: MsgFlag.REMAINING_GAS, bounce: false} flags;
    }

    function getEventAction() externalMsg internalMsg override public view responsible returns(EventAction _eventAction) {
        return {value: 0, flag: MsgFlag.REMAINING_GAS, bounce: false} eventAction;
    }

    /// @notice Set new configuration meta.
    /// @param _meta New configuration meta
    function setMeta(TvmCell _meta) override onlyOwner cashBack external {
        meta = _meta;
    }

    /// @dev Set end timestamp. Can be set only in case current value is 0.
    /// @param endTimestamp End timestamp.
    function setEndTimestamp(
        uint32 endTimestamp
    )
        override
        public
        onlyOwner
    {
        require(
            networkConfiguration.endTimestamp == 0,
            ErrorCodes.END_TIMESTAMP_ALREADY_SET
        );

        require(
            endTimestamp >= networkConfiguration.startTimestamp,
            ErrorCodes.TOO_LOW_END_TIMESTAMP
        );

        networkConfiguration.endTimestamp = endTimestamp;
    }

    function setFlags(
        uint64 _flags
    ) override onlyOwner cashBack external {
        flags = _flags;
    }

    function setEventInitialBalance(
        uint64 eventInitialBalance
    ) override onlyOwner cashBack external {
        basicConfiguration.eventInitialBalance = eventInitialBalance;
    }

    /// @dev Build initial data for event contract.
    /// Extends event vote data with configuration params.
    /// @param eventVoteData Event vote data structure, passed by relay
    function buildEventInitData(
        IEverscaleSolanaEvent.EverscaleSolanaEventVoteData eventVoteData
    ) internal view returns(
        IEverscaleSolanaEvent.EverscaleSolanaEventInitData eventInitData
    ) {
        eventInitData.voteData = eventVoteData;

        eventInitData.configuration = address(this);
        eventInitData.staking = basicConfiguration.staking;
    }

    /// @dev Deploy event contract
    /// @param eventVoteData Event vote data
    function deployEvent(
        IEverscaleSolanaEvent.EverscaleSolanaEventVoteData eventVoteData
    )
        override
        external
        reserveAtLeastTargetBalance()
    {
        require(msg.sender == networkConfiguration.eventEmitter, ErrorCodes.SENDER_IS_NOT_EVENT_EMITTER);
        require(msg.value >= basicConfiguration.eventInitialBalance, ErrorCodes.TOO_LOW_DEPLOY_VALUE);
        require(
            eventVoteData.eventTimestamp >= networkConfiguration.startTimestamp,
            ErrorCodes.EVENT_TIMESTAMP_LESS_THAN_START
        );

        if (networkConfiguration.endTimestamp != 0) {
            require(
                eventVoteData.eventTimestamp <= networkConfiguration.endTimestamp,
                ErrorCodes.EVENT_TIMESTAMP_HIGHER_THAN_END
            );
        }

        IEverscaleSolanaEvent.EverscaleSolanaEventInitData eventInitData = buildEventInitData(eventVoteData);

        address eventContract = _deriveEventAddress(eventInitData);

        emit NewEventContract(eventContract);

        _createEventContract(eventInitData, 0, MsgFlag.ALL_NOT_RESERVED);
    }

    /*
        @dev Derive the Solana event contract address from it's init data
        @param eventVoteData Solana event vote data
        @returns eventContract Address of the corresponding Solana event contract
    */
    function deriveEventAddress(
        IEverscaleSolanaEvent.EverscaleSolanaEventVoteData eventVoteData
    )
        externalMsg
        internalMsg
        override
        external
        view
        responsible
    returns (
        address eventContract
    ) {
        IEverscaleSolanaEvent.EverscaleSolanaEventInitData eventInitData = buildEventInitData(eventVoteData);
        return {value: 0, flag: MsgFlag.REMAINING_GAS, bounce: false} _deriveEventAddress(eventInitData);
    }

    function _createEventContract(
        IEverscaleSolanaEvent.EverscaleSolanaEventInitData _eventInitData,
        coins _value,
        uint8 _flag
    ) internal view {
        TvmCell stateInit = _buildEventStateInit(_eventInitData);

        if (eventAction == EventAction.MultivaultAlien) {
            new MultiVaultEverscaleSolanaEventAlien{
                value: _value,
                flag: _flag,
                stateInit: stateInit,
                wid: address(this).wid
            }(msg.sender, meta);

            return;
        }

        if (eventAction == EventAction.MultivaultNative) {
            new MultiVaultEverscaleSolanaEventNative{
                value: _value,
                flag: _flag,
                stateInit: stateInit,
                wid: address(this).wid
            }(msg.sender, meta);

            return;
        }

        if (eventAction == EventAction.TokenTransfer) {
            new TokenTransferEverscaleSolanaEvent{
                value: _value,
                flag: _flag,
                stateInit: stateInit,
                wid: address(this).wid
            }(msg.sender, meta);

            return;
        }

        if (eventAction == EventAction.Staking) {
            new StakingEverscaleSolanaEvent{
                value: _value,
                flag: _flag,
                stateInit: stateInit,
                wid: address(this).wid
            }(msg.sender, meta);
        }
    }

    function _deriveEventAddress(
        IEverscaleSolanaEvent.EverscaleSolanaEventInitData eventInitData
    ) internal view returns (address _event) {
        TvmCell stateInit = _buildEventStateInit(eventInitData);
        _event = address.makeAddrStd(address(this).wid, tvm.hash(stateInit));
    }

    function _buildEventStateInit(
        IEverscaleSolanaEvent.EverscaleSolanaEventInitData eventInitData
    ) internal view returns (TvmCell _stateInit) {
        if (eventAction == EventAction.MultivaultAlien) {
            _stateInit = abi.encodeStateInit({
                contr: MultiVaultEverscaleSolanaEventAlien,
                varInit: {
                    eventInitData: eventInitData
                },
                pubkey: 0,
                code: basicConfiguration.eventCode
            });
        } else if (eventAction == EventAction.MultivaultNative) {
            _stateInit = abi.encodeStateInit({
                contr: MultiVaultEverscaleSolanaEventNative,
                varInit: {
                    eventInitData: eventInitData
                },
                pubkey: 0,
                code: basicConfiguration.eventCode
            });
        } else if (eventAction == EventAction.TokenTransfer) {
            _stateInit = abi.encodeStateInit({
                contr: TokenTransferEverscaleSolanaEvent,
                varInit: {
                    eventInitData: eventInitData
                },
                pubkey: 0,
                code: basicConfiguration.eventCode
            });
        } else if (eventAction == EventAction.Staking) {
            _stateInit = abi.encodeStateInit({
                contr: StakingEverscaleSolanaEvent,
                varInit: {
                    eventInitData: eventInitData
                },
                pubkey: 0,
                code: basicConfiguration.eventCode
            });
        }
    }
}
